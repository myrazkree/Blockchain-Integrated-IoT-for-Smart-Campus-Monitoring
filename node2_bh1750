#include <WiFi.h>
#include <HTTPClient.h>
#include <Wire.h>
#include <BH1750.h>

// ----------------------------
// Light Sensor Initialization
// ----------------------------
BH1750 lightMeter;

// ----------------------------
// WiFi and Server Credentials
// ----------------------------
const char* ssid = "mirae";
const char* password = "miraena13";
const char* server = "https://amirazkree.pythonanywhere.com/add_data";

// ----------------------------
// Setup Function
// Runs once at startup
// ----------------------------
void setup() {

  Serial.begin(115200);         // Start serial monitor for debugging

  Wire.begin();                 // Initialize I2C communication

  lightMeter.begin();           // Initialize BH1750 sensor

  WiFi.begin(ssid, password);   // Connect to WiFi network

  // Wait until WiFi is connected
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("WiFi Connected");
}

// ----------------------------
// Main Loop
// Reads light sensor and sends data to server
// ----------------------------
void loop() {

  // Read light intensity in lux
  float lux = lightMeter.readLightLevel();
  
  // Create HTTP client object
  HTTPClient http;

  http.begin(server); // Connect to server endpoint
  http.addHeader("Content-Type", "application/json");

  // Determine light status based on threshold
  String status = (lux > 700.0) ? "Alert" : "Normal";

  // Build JSON payload
  String json =
    "{\"sensor_id\":\"S002\","
    "\"location\":\"Block B\","
    "\"type\":\"light\","
    "\"value\":" + String(lux) + ","
    "\"status\":\"" + status + "\"}";

  // Send HTTP POST request
  int response = http.POST(json);

  // Print server response code
  Serial.println(response);

  http.end();   // Close connection

  // Wait 5 seconds before next reading
  delay(5000);
}
